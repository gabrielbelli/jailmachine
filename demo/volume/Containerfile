# jm-demo-volume -- "the fast path for data is a volume, not a share"
#
# Host bind-mounts do work on jailmachine, at identity paths -- but over
# virtio-9p, which is slow. An engine-managed volume lives on the guest's ZFS
# pool at native speed, and outlives the container. That is what this shows.
#
#   jpodman run --rm -v jm-demo-data:/data ghcr.io/gabrielbelli/jm-demo-volume
#
# Run it twice to watch the log grow. Native FreeBSD image -- no --os flag.
FROM ghcr.io/freebsd/freebsd-runtime:15.1

LABEL org.opencontainers.image.title="jm-demo-volume" \
      org.opencontainers.image.description="Shows that container volumes live on the guest's ZFS pool -- the fast path for data, unlike a 9p host share." \
      org.opencontainers.image.source="https://github.com/gabrielbelli/jailmachine" \
      org.opencontainers.image.licenses="BSD-2-Clause"

# --chmod keeps the image free of RUN steps, so it cross-builds on Linux CI.
COPY --chmod=0755 volume.sh /usr/local/bin/volume-demo

# Deliberately NO `VOLUME /data`: without an explicit -v the image should
# show you that /data is only an image directory, so the difference between
# "a volume" and "not a volume" is visible in the demo.
ENTRYPOINT ["/usr/local/bin/volume-demo"]
